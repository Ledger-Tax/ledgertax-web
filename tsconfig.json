{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "incremental": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "esModuleInterop": true
  },
  "include": [
    "next-env.d.ts",
    "app",
    "test",
    "*.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "components",
    "lib",
    "scripts"
  ],
  "exclude": ["node_modules"]
}
